{
    frankenphp
    order php_server before file_server
}

:80 {
    root * /var/www/html/public
    encode zstd gzip

    # Security Headers
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Immutable caching for Vite compiled assets
    @assets path /build/*
    header @assets Cache-Control "public, max-age=31536000, immutable"

    # Static media caching
    @media path *.ico *.css *.js *.gif *.jpg *.jpeg *.png *.webp *.svg *.woff *.woff2
    header @media Cache-Control "public, max-age=2592000, no-transform"

    # FrankenPHP SAPI server
    php_server

    # Deny hidden files (.env, .git)
    @hidden path */.*
    error @hidden 404
}
