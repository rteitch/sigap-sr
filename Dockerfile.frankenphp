# ==============================================================================
# Stage 1: Build Frontend Assets (Vite, Vue 3, Tailwind v4)
# ==============================================================================
FROM node:22-alpine AS frontend-builder
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --prefer-offline --no-audit

COPY vite.config.js ./
COPY resources resources/
COPY public public/

RUN npm run build

# ==============================================================================
# Stage 2: Install PHP Composer Dependencies
# ==============================================================================
FROM composer:2 AS composer-builder
WORKDIR /app

COPY composer.json composer.lock ./

RUN composer install \
    --no-dev \
    --no-interaction \
    --prefer-dist \
    --optimize-autoloader \
    --ignore-platform-reqs \
    --no-scripts

COPY app app/
COPY bootstrap bootstrap/
COPY config config/
COPY database database/
COPY routes routes/

RUN composer dump-autoload --optimize --classmap-authoritative --ignore-platform-reqs --no-scripts

# ==============================================================================
# Stage 3: Production Runtime (FrankenPHP Caddy Server on Alpine)
# ==============================================================================
FROM dunglas/frankenphp:1-php8.3-alpine AS runtime

LABEL maintainer="Rizal Taufiq Hidayat <https://github.com/rteitch>"
LABEL description="SIGAP-SR FrankenPHP Production Container"

# Install production PHP extensions using FrankenPHP's built-in helper
RUN install-php-extensions \
    pdo_sqlite \
    pdo_mysql \
    mbstring \
    zip \
    gd \
    opcache \
    pcntl \
    bcmath \
    intl

WORKDIR /var/www/html

# Copy server & PHP configurations
COPY docker/Caddyfile /etc/caddy/Caddyfile
COPY docker/php.ini /usr/local/etc/php/conf.d/99-sigap.ini
COPY docker/frankenphp-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Copy application source code
COPY . .

# Copy optimized vendor from composer-builder
COPY --from=composer-builder /app/vendor /var/www/html/vendor

# Copy compiled frontend assets from frontend-builder
COPY --from=frontend-builder /app/public/build /var/www/html/public/build

# Discover production packages (clean host dev artifacts)
RUN rm -f /var/www/html/bootstrap/cache/*.php && \
    php artisan package:discover --ansi

# Setup storage & cache directory structure with proper permissions
RUN mkdir -p /var/www/html/storage/app/public \
             /var/www/html/storage/framework/cache/data \
             /var/www/html/storage/framework/sessions \
             /var/www/html/storage/framework/views \
             /var/www/html/storage/logs \
             /var/www/html/bootstrap/cache \
             /var/www/html/database \
    && chown -R www-data:www-data /var/www/html \
    && chmod -R 775 /var/www/html/storage /var/www/html/bootstrap/cache /var/www/html/database

EXPOSE 80
EXPOSE 443
EXPOSE 443/udp

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -f http://127.0.0.1/up || exit 1

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["frankenphp", "run", "--config", "/etc/caddy/Caddyfile"]
